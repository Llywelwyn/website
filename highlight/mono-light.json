{
  "name": "mono-light",
  "displayName": "Mono Light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#000000"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.declaration",
        "keyword.other",
        "storage"
      ],
      "settings": { "fontStyle": "bold italic" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.class",
        "support.type",
        "support.class",
        "constant.other.caps",
        "constant.other"
      ],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    }
  ]
}
